{
  "name": "rulegap",
  "version": "1.0.0",
  "description": "The rules say yes. The form says no. Local-first software consistency verifier.",
  "author": "RuleGap Contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx src/server/server.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/tests/e2e",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pdfjs-dist": "^4.4.168",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "esbuild": "^0.25.0"
  }
}
